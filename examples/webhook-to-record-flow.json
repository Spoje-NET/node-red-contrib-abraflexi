[
  {
    "id": "tab-wtr",
    "type": "tab",
    "label": "AbraFlexi – Webhook to Record",
    "info": "Canonical pattern for processing AbraFlexi change notifications:\n\n  abraflexi-webhook  →  Switch (by msg.topic)  →  evidence-type node  →  debug\n\nEach evidence-type node:\n  • fetches the full record from AbraFlexi by ID (msg.payload.id)\n  • emits msg.payload       — full record\n  • emits msg.summaryPayload — key fields only (kod, datum, firma, sumCelkem …)\n  • emits msg.writablePayload — fields safe for PUT/POST back to AbraFlexi\n  • emits msg.gdprFields    — GDPR personal-data field names\n  • emits msg.schema        — per-field type/constraint metadata\n\nSetup:\n  1. Double-click any evidence node and configure the AbraFlexi Server config node.\n  2. Register the webhook URL in AbraFlexi: Nastavení → Webhooky.\n  3. Trigger a change in AbraFlexi and watch the debug panel.\n\nTip: use msg.summaryPayload in downstream nodes for lightweight display/routing."
  },
  {
    "id": "cfg-wtr",
    "type": "abraflexi-config",
    "name": "AbraFlexi Server",
    "url": "https://your-abraflexi-host:5434",
    "company": "your_company_code"
  },
  {
    "id": "wtr-webhook",
    "type": "abraflexi-webhook",
    "z": "tab-wtr",
    "name": "AbraFlexi changes",
    "path": "/abraflexi/webhook",
    "x": 140,
    "y": 300,
    "wires": [
      [
        "wtr-switch"
      ]
    ]
  },
  {
    "id": "wtr-switch",
    "type": "switch",
    "z": "tab-wtr",
    "name": "route by evidence type",
    "property": "topic",
    "propertyType": "msg",
    "rules": [
      {
        "t": "eq",
        "v": "faktura-vydana",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "faktura-prijata",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "banka",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "adresar",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "objednavka-vydana",
        "vt": "str"
      },
      {
        "t": "else"
      }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 6,
    "x": 380,
    "y": 300,
    "wires": [
      [
        "wtr-fv"
      ],
      [
        "wtr-fp"
      ],
      [
        "wtr-banka"
      ],
      [
        "wtr-adresar"
      ],
      [
        "wtr-obj"
      ],
      [
        "wtr-other"
      ]
    ]
  },
