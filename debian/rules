#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	npm install --production --ignore-scripts

override_dh_auto_install:
	install -d debian/node-red-contrib-abraflexi/usr/share/nodejs/node-red-contrib-abraflexi
	cp -a abraflexi-webhook.js abraflexi-webhook.html package.json README.md \
		debian/node-red-contrib-abraflexi/usr/share/nodejs/node-red-contrib-abraflexi/
	[ -d node_modules ] && \
		install -d debian/node-red-contrib-abraflexi/usr/share/nodejs/node-red-contrib-abraflexi/node_modules && \
		cp -a node_modules/. debian/node-red-contrib-abraflexi/usr/share/nodejs/node-red-contrib-abraflexi/node_modules/ \
		|| true
	install -d debian/node-red-contrib-abraflexi/usr/share/metainfo
	install -m 644 debian/io.github.vitexus.node_red_contrib_abraflexi.metainfo.xml \
		debian/node-red-contrib-abraflexi/usr/share/metainfo/

override_dh_shlibdeps:

override_dh_strip:
